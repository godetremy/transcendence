{
	"uid": "infra-overview",
	"title": "Infra Overview",
	"tags": ["infra"],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"time": { "from": "now-1h", "to": "now" },
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Cibles UP",
			"gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "refId": "A", "expr": "sum(up)" }],
			"options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Connexions PostgreSQL",
			"gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "refId": "A", "expr": "sum(pg_stat_database_numbackends)" }],
			"options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Requetes nginx / s",
			"gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "refId": "A", "expr": "sum(rate(nginx_http_requests_total[5m]))" }],
			"options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Charge hote (1m)",
			"gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "refId": "A", "expr": "node_load1" }],
			"options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "CPU par conteneur",
			"gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])",
					"legendFormat": "{{name}}"
				}
			]
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "Memoire par conteneur",
			"gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
			"targets": [
				{
					"refId": "A",
					"expr": "container_memory_usage_bytes{name!=\"\"}",
					"legendFormat": "{{name}}"
				}
			]
		}
	]
}
