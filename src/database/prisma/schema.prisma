// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
	provider = "prisma-client"
	output   = "generated/"
}

datasource bde {
	provider = "postgresql"
}

model memberships {
	id				String		@id	@default(uuid())
	
	start_at		DateTime	@default(now())
	end_at			DateTime	@default(now())
	
	MemberUsers	users[]
}

model oauth_fortytwo {
	id				String		@id	@default(uuid())
	
	access_token 	String?
	refresh_token	String?
	valid_until		DateTime	@default(now())
	
	MemberUsers		users[]
}

model permission {
	id			String @id @default(uuid())

	admin			Boolean	@default(false)

	create_event	Boolean	@default(false)
	modify_event	Boolean	@default(false)
	delete_event	Boolean	@default(false)

	modify_event_other	Boolean	@default(false)
	delete_event_other	Boolean	@default(false)

	create_service	Boolean	@default(false)
	modify_service	Boolean	@default(false)
	delete_service	Boolean	@default(false)

	modify_service_other	Boolean	@default(false)
	delete_service_other	Boolean	@default(false)

	MemberUsers users[]
}

model users {
	id					String				@id	@default(uuid())
	
	oauth_fortytwo_id	String?
	oauth_fortytwo		oauth_fortytwo?		@relation(fields: [oauth_fortytwo_id], references: [id])
	
	memberships_id		String?
	memberships			memberships?		@relation(fields: [memberships_id], references: [id])

	permission_id		String?
	permission			permission?		@relation(fields: [permission_id], references: [id])
	
	fortytwo_user_id	Int?				@unique

	is_agent			Boolean				@default(false)
	is_agent_verified	Boolean?
	reason				String?

	mail				String				@unique
	password			String?
	first_name			String?
	last_name			String?
	full_name			String?


	profile_picture		String				@default("/images/default_user.png")

	created_at			DateTime			@default(now())
	updated_at			DateTime			@default(now())
}