// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
	provider = "prisma-client"
	output   = "generated/"
}

datasource bde {
	provider = "postgresql"
}

model memberships {
	id				String		@id	@default(uuid())
	
	start_at		DateTime	@default(now())
	end_at			DateTime	@default(now())
	
	MemberUsers	users[]
}

model oauth_fortytwo {
	id				String		@id	@default(uuid())
	
	access_token 	String?
	refresh_token	String?
	valid_until		DateTime	@default(now())
	
	MemberUsers		users[]
}

model registered_event {
	id							String		@id @default(uuid())

	user_id						String?
	user						users?		@relation(fields: [user_id], references: [id])

	created_at					DateTime	@default(now())

	registered_event_id			String? 	@unique
	event						event?		@relation(fields: [registered_event_id], references: [id])

}

model event {
	id						String			@id @default(uuid())

	author_id				String
	author					users			@relation(fields: [author_id], references: [id])

	registered				registered_event?

	title					String?
	description				String?

	max_inscription			Int			@default(0)

	start_at				DateTime	@default(now())
	end_at					DateTime	@default(now())
	created_at				DateTime	@default(now())
}

model users {
	id					String				@id	@default(uuid())
	
	oauth_fortytwo_id	String?
	oauth_fortytwo		oauth_fortytwo?		@relation(fields: [oauth_fortytwo_id], references: [id])
	
	memberships_id		String?
	memberships			memberships?		@relation(fields: [memberships_id], references: [id])

	events				event[]
	registered_event	registered_event[]
	
	fortytwo_user_id	Int?				@unique

	is_agent			Boolean				@default(false)
	is_agent_verified	Boolean?
	reason				String?

	mail				String				@unique
	password			String?
	first_name			String?
	last_name			String?
	full_name			String?


	profile_picture		String				@default("/images/default_user.png")

	created_at			DateTime			@default(now())
	updated_at			DateTime			@default(now())
}