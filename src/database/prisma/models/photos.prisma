model photos {
	id						String					@id		@default(uuid())

	path					String

	album_id				String
	updloaded_by_id			String

	created_at				DateTime				@default(now())
	updated_at				DateTime				@updatedAt

	album					photos_album			@relation(fields: [album_id], references: [id])
	updloaded_by			users					@relation(fields: [updloaded_by_id], references: [id])

	photos_album_reports	photos_album_reports[]
}